# Pipeline state: sources, pages, versions, sync runs, alerts
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rag_freshness
# The index to keep fresh: Document QA's database
INDEX_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/docqa
# Path to the document-qa-citations repository (its parser, chunker and store are reused)
DOCQA_PATH=../document-qa-citations

ANTHROPIC_API_KEY=sk-ant-...
VOYAGE_API_KEY=pa-...

# Optional
# AGENT_MODEL=claude-opus-5-5
# SCHEDULER_TICK_SECONDS=30
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...
# RESPECT_ROBOTS=true
# ALLOW_PRIVATE_URLS=false

# Tests only (both are truncated by the test suite)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rag_freshness_test
TEST_INDEX_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rag_freshness_index_test
